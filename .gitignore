__pycache__/
*.pyc

# Generated locally by the reproduction steps in the README:
#   data/          synthetic and experimental train + eval sets, and the
#                  MicroSIG download
#   network/runs/  training checkpoints
# templates/ and the two published checkpoints under network/ are not
# generated and stay tracked.
data/
network/runs/

# Generated tiles are .npz.  The blanket rule guards against a stray multi-GB
# tile outside data/; the exceptions are distributed, not generated.
*.npz
!example_data/**/*.npz
!templates/**/*.npz
!experimental/**/*.npz

# The metrics CSVs and experimental/tracks/ are tracked:
# make_figures_experimental.py reads the tracks and nothing else.  The rendered
# figures are not -- they are regenerated from those tables.
/results/figures
